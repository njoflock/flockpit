# URL pública de la app (sin barra final). En local: http://localhost:3000
APP_URL=http://localhost:3000

# Clave para firmar la sesión (mínimo 32 caracteres al azar)
SESSION_SECRET=
# Clave para cifrar tokens de Microsoft y Slack: 32 bytes en base64.
# Generala con:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Supabase (Project Settings > API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Microsoft Entra (registro de la aplicación)
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Tipo de cuentas: "consumers" para cuentas personales (Outlook.com, Hotmail),
# "organizations" para cuentas laborales o el ID de un tenant específico.
MS_TENANT_ID=consumers
# Teams solo existe en cuentas laborales. Con cuentas personales dejalo en false.
MS_INCLUDE_TEAMS=false

# Slack (aplicación creada con slack-app-manifest.yml)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Análisis con Claude (opcional: sin clave, la app funciona sin clasificación automática)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Secreto para la sincronización programada (GitHub Actions o Vercel Cron)
CRON_SECRET=
